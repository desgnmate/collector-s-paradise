cript><script src=\"/_next/static/chunks/04yq-kgokvce4.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" crossorigin=\"anonymous\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><meta name=\"next-size-adjust\" content=\"\"/><meta name=\"theme-color\" content=\"#5C8FC9\"/><title>Volunteers | Collector&#x27;s Paradise</title><meta name=\"description\" content=\"Join the Collector&#x27;s Paradise volunteer team! Help run Melbourne&#x27;s premier Pokémon TCG events, meet fellow collectors, and be part of the community.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"Pokemon cards,trading cards,Melbourne events,card collecting,TCG,Pokemon TCG,card trading,rare cards,collector events,Pokemon Melbourne,card show Melbourne\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://collectorsparadise.com.au/volunteers\"/><meta property=\"og:title\" content=\"Volunteers | Collector&#x27;s Paradise\"/><meta property=\"og:description\" content=\"Join the Collector&#x27;s Paradise volunteer team and be part of Melbourne&#x27;s premier Pokémon TCG events.\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Collector&#x27;s Paradise | Pokémon Trading Card Events\"/><meta name=\"twitter:description\" content=\"Where collectors meet, trade &amp; connect. Join Melbourne&#x27;s most exciting trading card event.\"/><meta name=\"twitter:image\" content=\"https://collectorsparadise.com.au/og-image.png\"/><link rel=\"icon\" href=\"/icon.png?icon.0pbo66~93xbg6.png\" sizes=\"1024x1024\" type=\"image/png\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"logo\":\"https://collectorsparadise.com.au/images/logo.png\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Melbourne\",\"addressCountry\":\"AU\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"email\":\"hello@collectorsparadise.com.au\",\"contactType\":\"customer service\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\"}</script><main><nav class=\"navbar  \"><div class=\"navbar-inner\"><a class=\"navbar-logo-link\" href=\"/\"><img alt=\"Collector&#x27;s Paradise\" width=\"168\" height=\"55\" decoding=\"async\" data-nimg=\"1\" class=\"navbar-logo\" style=\"color:transparent;width:auto\" src=\"/_next/static/media/logo.0qli1hbt-52sd.png\"/></a><div class=\"navbar-actions\"><a class=\"navbar-join-pill\" href=\"/vendors/apply\">APPLY AS VENDOR</a><div class=\"navbar-menu-wrapper\" style=\"position:relative\"><button class=\"navbar-menu-icon \" aria-label=\"Toggle menu\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button><div class=\"navbar-dropdown \"><div class=\"navbar-dropdown-inner\"><a href=\"/\"><span class=\"menu-item-text\">Home</span></a><a href=\"/about\"><span class=\"menu-item-text\">About</span></a><a href=\"/events\"><span class=\"menu-item-text\">Events</span></a><a href=\"/vendors\"><span class=\"menu-item-text\">Vendors</span></a><a href=\"/sponsorship\"><span class=\"menu-item-text\">Sponsorship</span></a><a href=\"/volunteers\"><span class=\"menu-item-text\">Volunteers</span></a></div></div></div></div></div></nav><section class=\"vendors-page-header-section\"><div class=\"container\"><div class=\"vendors-page-header\"><span class=\"eyebrow-badge\">JOIN THE TEAM</span><h1 class=\"section-title\">VOLUNTEERS</h1><p class=\"section-subtitle\">Be part of the action! Join our volunteer team and help make Collector&#x27;s Paradise events unforgettable. Meet fellow collectors and contribute to the community.</p></div></div></section><section class=\"vendors-grid-section\"><div class=\"container\"><div class=\"volunteer-roles-grid\"><div class=\"volunteer-role-card\"><div class=\"role-icon\"><svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21h18M5 21V7l8-4 8 4v14M8 21v-9a4 4 0 0 1 4-4v0a4 4 0 0 1 4 4v9\"></path></svg></div><h3 class=\"role-title\">Event Setup Crew</h3><p class=\"role-description\">Help set up tables, chairs, signage, and decorations before the event starts. Early birds welcome!</p><span class=\"role-time\">Shift: 7:00 AM - 10:00 AM</span></div><div class=\"volunteer-role-card\"><div class=\"role-icon\"><svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg></div><h3 class=\"role-title\">Registration Desk</h3><p class=\"role-description\">Greet attendees, check tickets, hand out event materials, and answer questions.</p><span class=\"role-time\">Shift: 9:00 AM - 1:00 PM or 1:00 PM - 5:00 PM</span></div><div class=\"volunteer-role-card\"><div class=\"role-icon\"><svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 16v-4M12 8h.01\"></path></svg></div><h3 class=\"role-title\">Floor Guides</h3><p class=\"role-description\">Roam the event floor, assist attendees with directions, and ensure smooth flow throughout the venue.</p><span class=\"role-time\">Shift: 10:00 AM - 2:00 PM or 2:00 PM - 6:00 PM</span></div><div class=\"volunteer-role-card\"><div class=\"role-icon\"><svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line></svg></div><h3 class=\"role-title\">Breakdown Crew</h3><p class=\"role-description\">Help pack up after the event, clean the venue, and ensure everything is returned to order.</p><span class=\"role-time\">Shift: 6:00 PM - 8:00 PM</span></div></div></div></section><section class=\"vendors-cta-section\"><div class=\"container\"><div class=\"vendors-cta-inner\"><div class=\"vendors-cta-text\"><div class=\"vendors-cta-badge\"><span>JOIN US</span></div><h2 class=\"vendors-cta-title\">READY TO VOLUNTEER?</h2><p class=\"vendors-cta-subtitle\">Fill out the form below and we&#x27;ll get in touch with available shifts and details. No experience needed — just bring your enthusiasm!</p></div><div class=\"vendors-cta-actions\"><a class=\"vendors-cta-btn-primary\" href=\"/volunteers/apply\">Sign Up to Volunteer</a><a class=\"vendors-cta-btn-secondary\" href=\"/events\">View Upcoming Events</a></div></div></div></section><footer class=\"new-footer-section\"><div class=\"new-footer-container\"><div class=\"footer-cta-part\"><p class=\"footer-eyebrow\">Join Collector&#x27;s Club</p><h2 class=\"footer-cta-title\">BE PART OF THE<br/>EXPERIENCE</h2><p class=\"footer-cta-subtitle\">Connect with collectors, share the passion,<br/>and be part of something bigger.</p><a class=\"btn btn-yellow footer-cta-btn\" href=\"#\">Subscribe</a><div class=\"polaroid-cards-wrapper\"><div class=\"polaroid p-1\"><img alt=\"Collectors meeting at a Pokémon trading card event\" loading=\"lazy\" width=\"150\" height=\"210\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/footer-card-1.0abpd3t9tn5ys.jpg\"/></div><div class=\"polaroid p-2\"><img alt=\"Live event experience at Collector&#x27;s Paradise\" loading=\"lazy\" width=\"150\" height=\"210\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/footer-card-2.0voz.i4j9rhr0.jpg\"/></div><div class=\"polaroid p-3\"><img alt=\"Fun and culture at the collector community\" loading=\"lazy\" width=\"150\" height=\"210\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/footer-card-3.0k96bk8n5-agg.jpg\"/></div><div class=\"polaroid p-4\"><img alt=\"Browsing rare Pokemon card collections\" loading=\"lazy\" width=\"150\" height=\"210\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/footer-card-4.12yowicjs9~_a.jpg\"/></div></div></div><div class=\"footer-main-part\"><div style=\"cursor:pointer;transition:filter 0.2s ease;filter:none;position:relative\" role=\"button\" tabindex=\"0\" aria-label=\"Collector&#x27;s Paradise\"><img alt=\"Collector&#x27;s Paradise\" loading=\"lazy\" width=\"700\" height=\"200\" decoding=\"async\" data-nimg=\"1\" class=\"footer-hero-logo\" style=\"color:transparent;object-fit:contain\" src=\"/_next/static/media/footer-logo.0io-tzh2nsvjl.p