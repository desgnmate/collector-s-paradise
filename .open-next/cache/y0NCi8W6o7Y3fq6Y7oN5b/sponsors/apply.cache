"company_size\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\"><option value=\"\">Select size...</option><option value=\"1-10 employees\">1-10 employees</option><option value=\"11-50 employees\">11-50 employees</option><option value=\"51-200 employees\">51-200 employees</option><option value=\"201-500 employees\">201-500 employees</option><option value=\"500+ employees\">500+ employees</option></select></div></div></div><div class=\"form-section\" style=\"margin-bottom:2.5rem\"><h3 class=\"form-section-title\" style=\"font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#666;margin-bottom:1.5rem;padding-bottom:0.75rem;border-bottom:2px solid var(--color-yellow)\">Contact Information</h3><div class=\"form-row\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem\"><div class=\"form-group\"><label for=\"contact_name\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Contact Name *</label><input type=\"text\" id=\"contact_name\" required=\"\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\" name=\"contact_name\"/></div><div class=\"form-group\"><label for=\"contact_position\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Position/Title</label><input type=\"text\" id=\"contact_position\" placeholder=\"e.g., Marketing Director, CEO\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\" name=\"contact_position\"/></div></div><div class=\"form-row\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem\"><div class=\"form-group\"><label for=\"contact_email\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Email Address *</label><input type=\"email\" id=\"contact_email\" required=\"\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\" name=\"contact_email\"/></div><div class=\"form-group\"><label for=\"contact_phone\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Phone Number</label><input type=\"tel\" id=\"contact_phone\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\" name=\"contact_phone\"/></div></div></div><div class=\"form-section\" style=\"margin-bottom:2.5rem\"><h3 class=\"form-section-title\" style=\"font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#666;margin-bottom:1.5rem;padding-bottom:0.75rem;border-bottom:2px solid var(--color-yellow)\">Sponsorship Details</h3><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label for=\"sponsorship_tier\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Preferred Sponsorship Tier</label><select id=\"sponsorship_tier\" name=\"sponsorship_tier\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\"><option value=\"\">Select a tier...</option><option value=\"platinum\">Platinum ($5,000+)</option><option value=\"gold\">Gold ($2,500+)</option><option value=\"silver\">Silver ($1,000+)</option><option value=\"custom\">Custom</option></select></div><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label class=\"form-label\" style=\"display:block;margin-bottom:0.75rem;font-weight:600;color:var(--color-dark)\">Sponsorship Interests * (Select all that apply)</label><div class=\"checkbox-group\" style=\"display:grid;grid-template-columns:1fr;gap:0.75rem\"><label class=\"checkbox-label\" style=\"display:flex;align-items:flex-start;gap:0.75rem;padding:1rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"margin-top:0.25rem;accent-color:var(--color-yellow)\" name=\"sponsorship_interest\" value=\"Event Sponsorship\"/><div><span style=\"font-weight:600;color:var(--color-dark);display:block\">Event Sponsorship</span><span style=\"font-size:0.9rem;color:#666\">Sponsor the entire event or specific areas</span></div></label><label class=\"checkbox-label\" style=\"display:flex;align-items:flex-start;gap:0.75rem;padding:1rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"margin-top:0.25rem;accent-color:var(--color-yellow)\" name=\"sponsorship_interest\" value=\"Prize Donation\"/><div><span style=\"font-weight:600;color:var(--color-dark);display:block\">Prize Donation</span><span style=\"font-size:0.9rem;color:#666\">Provide prizes for tournaments/raffles</span></div></label><label class=\"checkbox-label\" style=\"display:flex;align-items:flex-start;gap:0.75rem;padding:1rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"margin-top:0.25rem;accent-color:var(--color-yellow)\" name=\"sponsorship_interest\" value=\"Workshop Hosting\"/><div><span style=\"font-weight:600;color:var(--color-dark);display:block\">Workshop Hosting</span><span style=\"font-size:0.9rem;color:#666\">Host educational workshops</span></div></label><label class=\"checkbox-label\" style=\"display:flex;align-items:flex-start;gap:0.75rem;padding:1rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"margin-top:0.25rem;accent-color:var(--color-yellow)\" name=\"sponsorship_interest\" value=\"Panel Speaking\"/><div><span style=\"font-weight:600;color:var(--color-dark);display:block\">Panel Speaking</span><span style=\"font-size:0.9rem;color:#666\">Participate in expert panels</span></div></label><label class=\"checkbox-label\" style=\"display:flex;align-items:flex-start;gap:0.75rem;padding:1rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"margin-top:0.25rem;accent-color:var(--color-yellow)\" name=\"sponsorship_interest\" value=\"Brand Activation\"/><div><span style=\"font-weight:600;color:var(--color-dark);display:block\">Brand Activation</span><span style=\"font-size:0.9rem;color:#666\">Interactive brand experience booth</span></div></label></div></div><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label for=\"budget_range\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Budget Range</label><select id=\"budget_range\" name=\"budget_range\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\"><option value=\"\">Select budget range...</option><option value=\"$1,000 - $2,500\">$1,000 - $2,500</option><option value=\"$2,500 - $5,000\">$2,500 - $5,000</option><option value=\"$5,000 - $10,000\">$5,000 - $10,000</option><option value=\"$10,000 - $25,000\">$10,000 - $25,000</option><option value=\"$25,000+\">$25,000+</option></select></div><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label for=\"previous_sponsor\" class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;cursor:pointer\"><input type=\"checkbox\" id=\"previous_sponsor\" style=\"accent-color:var(--color-yellow)\" name=\"previous_sponsor\"/><span style=\"font-weight:600;color:var(--color-dark)\">We have sponsored Collector&#x27;s Paradise events before</span></label></div></div><div class=\"form-section\" style=\"margin-bottom:2.5rem\"><h3 class=\"form-section-title\" style=\"font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#666;margin-bottom:1.5rem;padding-bottom:0.75rem;border-bottom:2px solid var(--color-yellow)\">Brand &amp; Marketing</h3><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label for=\"brand_description\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Brand Description * (Brief overview of your company/brand)</label><textarea id=\"brand_description\" name=\"brand_description\" required=\"\" rows=\"4\" placeholder=\"Tell us about your brand, products, and target audience...\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;resize:vertical;transition:border-color 0.2s\"></textarea></div><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label for=\"social_media_links\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Social Media Links</label><input type=\"url\" id=\"social_media_links\" placeholder=\"https://instagram.com/yourbrand or https://facebook.com/yourbrand\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;transition:border-color 0.2s\" name=\"social_media_links\"/></div><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label for=\"marketing_goals\" class=\"form-label\" style=\"display:block;margin-bottom:0.5rem;font-weight:600;color:var(--color-dark)\">Marketing Goals (What do you hope to achieve?)</label><textarea id=\"marketing_goals\" name=\"marketing_goals\" rows=\"3\" placeholder=\"e.g., Brand awareness, product launches, community engagement...\" class=\"form-input\" style=\"width:100%;padding:0.75rem 1rem;border:2px solid #e5e5e5;border-radius:6px;font-size:1rem;resize:vertical;transition:border-color 0.2s\"></textarea></div></div><div class=\"form-section\" style=\"margin-bottom:2.5rem\"><h3 class=\"form-section-title\" style=\"font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#666;margin-bottom:1.5rem;padding-bottom:0.75rem;border-bottom:2px solid var(--color-yellow)\">Event Preferences</h3><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label class=\"form-label\" style=\"display:block;margin-bottom:0.75rem;font-weight:600;color:var(--color-dark)\">Events Interested In</label><div class=\"checkbox-group\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:0.75rem\"><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"events_interested\" value=\"Monthly Main Event\"/><span style=\"font-weight:500;color:var(--color-dark)\">Monthly Main Event</span></label><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"events_interested\" value=\"Special Holiday Events\"/><span style=\"font-weight:500;color:var(--color-dark)\">Special Holiday Events</span></label><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"events_interested\" value=\"Tournament Series\"/><span style=\"font-weight:500;color:var(--color-dark)\">Tournament Series</span></label><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"events_interested\" value=\"Community Meetups\"/><span style=\"font-weight:500;color:var(--color-dark)\">Community Meetups</span></label><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"events_interested\" value=\"Launch Parties\"/><span style=\"font-weight:500;color:var(--color-dark)\">Launch Parties</span></label></div></div><div class=\"form-group\" style=\"margin-bottom:1.5rem\"><label class=\"form-label\" style=\"display:block;margin-bottom:0.75rem;font-weight:600;color:var(--color-dark)\">Additional Services</label><div class=\"checkbox-group\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:0.75rem\"><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"additional_services\" value=\"Workshop/Panel Session\"/><span style=\"font-weight:500;color:var(--color-dark)\">Workshop/Panel Session</span></label><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"additional_services\" value=\"Prize Pool Contribution\"/><span style=\"font-weight:500;color:var(--color-dark)\">Prize Pool Contribution</span></label><label class=\"checkbox-label\" style=\"display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px solid #e5e5e5;border-radius:6px;cursor:pointer;transition:all 0.2s\"><input type=\"checkbox\" style=\"accent-color:var(--color-yellow)\" name=\"additional_services\" value=\"Exclusive Product Launch\"/><span style=\"font-weight:500;color:var(--color-dark)\">Exclusive Product Launch</span