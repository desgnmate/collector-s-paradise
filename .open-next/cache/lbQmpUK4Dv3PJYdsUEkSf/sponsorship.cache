"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"logo\":\"https://collectorsparadise.com.au/images/logo.png\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Melbourne\",\"addressCountry\":\"AU\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"email\":\"hello@collectorsparadise.com.au\",\"contactType\":\"customer service\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\"}</script><main><nav class=\"navbar  \"><div class=\"navbar-inner\"><a class=\"navbar-logo-link\" href=\"/\"><img alt=\"Collector&#x27;s Paradise\" width=\"168\" height=\"55\" decoding=\"async\" data-nimg=\"1\" class=\"navbar-logo\" style=\"color:transparent;width:auto\" src=\"/_next/static/media/logo.0qli1hbt-52sd.png\"/></a><div class=\"navbar-actions\"><a class=\"navbar-join-pill\" href=\"/vendors/apply\">APPLY AS VENDOR</a><div class=\"navbar-menu-wrapper\" style=\"position:relative\"><button class=\"navbar-menu-icon  \" aria-label=\"Toggle menu\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button><div class=\"navbar-dropdown \"><div class=\"navbar-dropdown-inner\"><a href=\"/about\"><span class=\"menu-item-text\">About</span></a><a href=\"/events\"><span class=\"menu-item-text\">Events</span></a><a href=\"/vendors\"><span class=\"menu-item-text\">Vendors</span></a><a href=\"/sponsorship\"><span class=\"menu-item-text\">Sponsorship</span></a><a href=\"/volunteers\"><span class=\"menu-item-text\">Volunteers</span></a></div></div></div></div></div></nav><section class=\"vendors-page-header-section\"><div class=\"container\"><div class=\"vendors-page-header\"><span class=\"eyebrow-badge\">PARTNERSHIPS</span><h1 class=\"section-title\">SPONSORSHIP</h1><p class=\"section-subtitle\">Partner with Collector&#x27;s Paradise and connect with Melbourne&#x27;s most passionate Pokémon TCG community. Reach thousands of collectors at our events.</p></div></div></section><section class=\"vendors-grid-section\"><div class=\"container\"><div class=\"sponsorship-tiers-grid\"><div class=\"sponsorship-tier-card platinum\"><div class=\"tier-header\"><span class=\"tier-badge\">PLATINUM</span><h2 class=\"tier-title\">$5,000+</h2></div><ul class=\"tier-benefits\"><li>Premium booth location (high-traffic area)</li><li>Logo on all event marketing materials</li><li>Featured social media posts (3x)</li><li>Stage announcement recognition</li><li>Exclusive email newsletter feature</li><li>Complimentary vendor table</li></ul></div><div class=\"sponsorship-tier-card gold\"><div class=\"tier-header\"><span class=\"tier-badge\">GOLD</span><h2 class=\"tier-title\">$2,500+</h2></div><ul class=\"tier-benefits\"><li>Priority booth selection</li><li>Logo on event website</li><li>Social media mention (2x)</li><li>Stage announcement recognition</li><li>10% discount on additional tables</li></ul></div><div class=\"sponsorship-tier-card silver\"><div class=\"tier-header\"><span class=\"tier-badge\">SILVER</span><h2 class=\"tier-title\">$1,000+</h2></div><ul class=\"tier-benefits\"><li>Standard booth location</li><li>Name listed on event website</li><li>Social media mention (1x)</li><li>5% discount on additional tables</li></ul></div></div></div></section><section class=\"vendors-cta-section\"><div class=\"container\"><div class=\"vendors-cta-inner\"><div class=\"vendors-cta-text\"><div class=\"vendors-cta-badge\"><span>WHY SPONSOR</span></div><h2 class=\"vendors-cta-title\">REACH 2,000+ COLLECTORS PER EVENT</h2><p class=\"vendors-cta-subtitle\">Our events attract serious collectors, players, and enthusiasts from across Melbourne and beyond. Sponsorship gives your brand direct access to this engaged community.</p></div><div class=\"vendors-cta-actions\"><a class=\"vendors-cta-btn-primary\" href=\"/sponsors/apply\">Become a Sponsor</a><a class=\"vendors-cta-btn-secondary\" href=\"/about\">Learn More About Us</a></div></div></div></section><footer class=\"new-footer-section\"><div class=\"new-footer-container\"><div class=\"footer-cta-part\"><p class=\"footer-eyebrow\">JOIN THE COMMUNITY</p><h2 class=\"footer-cta-title\">BE PART OF THE<br/>EXPERIENCE</h2><p class=\"footer-cta-subtitle\">Connect with collectors, share the passion,<br/>and be part of something bigger.</p><a class=\"btn btn-yellow footer-cta-btn\" href=\"/events\">Buy Tickets</a><div class=\"polaroid-cards-wrapper\"><div class=\"polaroid p-1\"><img alt=\"Collectors meeting at a Pokémon trading card event\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/meet-fans.11dg6k0o.ug7q.png\"/></div><div class=\"polaroid p-2\"><img alt=\"Live event experience at Collector&#x27;s Paradise\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/event-experience.04_zb~wdb.tw1.png\"/></div><div class=\"polaroid p-3\"><img alt=\"Fun and culture at the collector community\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/culture-fun.163o5c1htrrun.png\"/></div><div class=\"polaroid p-4\"><img alt=\"Browsing rare Pokémon card collections\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" 