type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"logo\":\"https://collectorsparadise.com.au/images/logo.png\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Melbourne\",\"addressCountry\":\"AU\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"email\":\"hello@collectorsparadise.com.au\",\"contactType\":\"customer service\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\"}</script><nav class=\"navbar  \"><div class=\"navbar-inner\"><a class=\"navbar-logo-link\" href=\"/\"><img alt=\"Collector&#x27;s Paradise\" width=\"168\" height=\"55\" decoding=\"async\" data-nimg=\"1\" class=\"navbar-logo\" style=\"color:transparent;width:auto\" src=\"/_next/static/media/logo.0qli1hbt-52sd.png\"/></a><div class=\"navbar-actions\"><a class=\"navbar-join-pill\" href=\"/vendors/apply\">APPLY AS VENDOR</a><div class=\"navbar-menu-wrapper\" style=\"position:relative\"><button class=\"navbar-menu-icon  nav-icon-gray\" aria-label=\"Toggle menu\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button><div class=\"navbar-dropdown \"><div class=\"navbar-dropdown-inner\"><a href=\"/about\"><span class=\"menu-item-text\">About</span></a><a href=\"/events\"><span class=\"menu-item-text\">Events</span></a><a href=\"/vendors\"><span class=\"menu-item-text\">Vendors</span></a></div></div></div></div></div></nav><main class=\"about-page-wrapper\"><section class=\"about-hero-section\"><div class=\"about-hero-container\"><div class=\"about-hero-content\" style=\"opacity:0;transform:translateY(30px)\"><span class=\"about-eyebrow\">Our Story</span><h1 class=\"about-title\">About <span class=\"title-accent\">Us</span></h1><p class=\"about-description\">Collector&#x27;s Paradise is Melbourne&#x27;s premier destination for TCG enthusiasts. We bring the community together through immersive events, live pack breaks, expert evaluations, and a curated marketplace for the rarest finds.</p></div><div class=\"about-hero-stats\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"stat-item\"><span class=\"stat-number\">50+</span><span class=\"stat-label\">Events Hosted</span></div><div class=\"stat-divider\"></div><div class=\"stat-item\"><span class=\"stat-number\">10K+</span><span class=\"stat-label\">Collectors</span></div><div class=\"stat-divider\"></div><div class=\"stat-item\"><span class=\"stat-number\">100+</span><span class=\"stat-label\">Vendors</span></div></div></div></section><section class=\"experiences-section\"><div class=\"experiences-container\"><div class=\"experiences-header\" style=\"opacity:0;transform:translateY(30px)\"><span class=\"section-eyebrow\">What You&#x27;ll Experience</span><h2 class=\"section-heading\">Discover <span class=\"heading-accent\">Collector&#x27;s Paradise</span></h2><p class=\"section-subtitle\">Every event is a new adventure. Collect experiences, meet fellow trainers, and discover rare treasures.</p></div><div class=\"experiences-grid\"><div class=\"experience-card\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"experience-card-image\"><img alt=\"PSA Card Evaluations\" loading=\"lazy\" width=\"625\" height=\"774\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;object-fit:cover\" src=\"/_next/static/media/3rd-section-card-image.0tv_qrpgh577p.jpg\"/></div><div class=\"experience-card-content\"><h3 class=\"experience-card-title\">PSA Card Evaluations</h3><p class=\"experience-card-desc\">Get your rare finds evaluated by experts and learn the true value of your collection. Real-time market data at your fingertips.</p></div><div class=\"experience-card-footer\"><span class=\"card-number\">01</span><span class=\"learn-more\">Learn More</span></div></div><div class=\"experience-card\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"experience-card-image\"><img alt=\"Guest Signings\" loading=\"lazy\" width=\"1024\" height=\"1024\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;object-fit:cover\" src=\"/_next/static/media/meet-fans.11dg6k0o.ug7q.png\"/></div><div class=\"experience-card-content\"><h3 class=\"experience-card-title\">Guest Signings</h3><p class=\"experience-card-desc\">Meet your favorite artists and creators. Get your cards signed and captured in the moment. Experience pop culture history live.</p></div><div class=\"experience-card-footer\"><span class=\"card-number\">02</span><span class=\"learn-more\">Learn More</span></div></div><div class=\"experience-card\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"experience-card-image\"><img alt=\"Buy / Sell / Trade\" loading=\"lazy\" width=\"1024\" height=\"1024\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;object-fit:cover\" src=\"/_next/static/media/event-experience.04_zb~wdb.tw1.png\"/></div><div class=\"experience-card-content\"><h3 class=\"experience-card-title\">Buy / Sell / Trade</h3><p class=\"experience-card-desc\">The heart of the event. Connect with thousands of collectors. Find that one-of-a-kind card you&#x27;ve been searching for years.</p></div><div class=\"experience-card-footer\"><span class=\"card-number\">03</span><span class=\"learn-more\">Learn More</span></div></div></div></div></section><section class=\"badges-section\"><div class=\"badges-bg-grid\"></div><div class=\"badges-container\"><div class=\"badges-header\" style=\"opacity:0;transform:translateY(30px)\"><span class=\"section-eyebrow-dark\">Your Journey Awaits</span><h2 class=\"section-heading-dark\">Earn <span class=\"heading-yellow\">Gym Badges</span></h2><p class=\"section-desc-dark\">Every event is a chance to earn new badges. Collect them all and become a true Champion of Collector&#x27;s Paradise.</p></div><div class=\"badges-grid\"><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.1</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🎪</div></div><h3 class=\"badge-title\">First Event</h3><p class=\"badge-desc\">Attended your first Collector&#x27;s Paradise event</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.2</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🃏</div></div><h3 class=\"badge-title\">Card Collector</h3><p class=\"badge-desc\">Built a collection of 50+ cards</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.3</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🤝</div></div><h3 class=\"badge-title\">Trader</h3><p class=\"badge-desc\">Completed your first trade with another collector</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.4</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">⭐</div></div><h3 class=\"badge-title\">Rare Find</h3><p class=\"badge-desc\">Discovered a rare or holographic card</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.5</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🏪</div></div><h3 class=\"badge-title\">Vendor Ally</h3><p class=\"badge-desc\">Purchased from 5+ different vendors</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.6</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🏆</div></div><h3 class=\"badge-title\">Champion</h3><p class=\"badge-desc\">Attended 10+ events and became a community pillar</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div></div><div class=\"badges-cta\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"cta-content\"><h3 class=\"cta-title\">Ready to Start Your Collection?</h3><p class=\"cta-subtitle\">Join our next event and begin earning your first badge today.</p><a class=\"cta-button\" href=\"/events\"><span>View Upcoming Events</span><span class=\"cta-arrow\">→</span></a></div></div></div></section></main><footer class=\"new-footer-section\"><div class=\"new-footer-container\"><div class=\"footer-cta-part\"><p class=\"footer-eyebrow\">JOIN THE COMMUNITY</p><h2 class=\"footer-cta-title\">BE PART OF THE<br/>EXPERIENCE</h2><p class=\"footer-cta-subtitle\">Connect with collectors, share the passion,<br/>and be part of something bigger.</p><a class=\"btn btn-yellow footer-cta-btn\" href=\"/events\">Buy Tickets</a><div class=\"polaroid-cards-wrapper\"><div class=\"polaroid p-1\"><img alt=\"Collectors meeting at a Pokémon trading card event\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"