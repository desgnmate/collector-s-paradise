ype\":\"Question\",\"name\":\"What is Collector's Paradise?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Collector's Paradise is Melbourne's premier trading card and collectibles event series. We host live Pokémon TCG, Yu-Gi-Oh!, One Piece, Magic: The Gathering, and sports card events where collectors buy, sell, trade, and connect.\"}},{\"@type\":\"Question\",\"name\":\"Where is the next Collector's Paradise event in Melbourne?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our events are held at venues across metropolitan Melbourne, Victoria. Check the Events page for the next scheduled date, venue address, and ticket availability.\"}},{\"@type\":\"Question\",\"name\":\"How do I buy tickets to a Collector's Paradise event?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tickets are available on our Events page. Select an upcoming event, choose your pass type, and complete secure checkout. Tickets are delivered to your email instantly.\"}},{\"@type\":\"Question\",\"name\":\"How do I become a vendor at Collector's Paradise?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Apply through the Vendors page. We accept applications from traders of Pokémon TCG, Yu-Gi-Oh!, One Piece TCG, sports cards, graded cards, vintage collectibles, and accessories. Approved vendors receive a booth assignment and access to our buyer community.\"}},{\"@type\":\"Question\",\"name\":\"What kinds of cards and collectibles can I buy and sell?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Pokémon trading cards (vintage and modern), Yu-Gi-Oh!, Magic: The Gathering, One Piece TCG, Dragon Ball Super, sports cards, graded cards, sealed product, accessories, and vintage or retro collectibles.\"}},{\"@type\":\"Question\",\"name\":\"Does Collector's Paradise run events outside Melbourne?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our flagship series is based in Melbourne, Victoria, Australia. We partner with regional collectors and vendors across Victoria for satellite events announced on the Events page.\"}}]}6:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$8\"}}]\n7:[\"$\",\"$L9\",null,{\"children\":[\"$\",\"$La\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$Lb\",null,{}],\"notFound\":[[\"$\",\"main\",null,{\"children\":[[\"$\",\"$Lc\",null,{}],[\"$\",\"section\",null,{\"className\":\"not-found-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"not-found-content\",\"children\":[[\"$\",\"span\",null,{\"className\":\"not-found-code\",\"children\":\"404\"}],[\"$\",\"h1\",null,{\"className\":\"not-found-title\",\"children\":\"PAGE NOT FOUND\"}],[\"$\",\"p\",null,{\"className\":\"not-found-desc\",\"children\":\"Looks like this page got lost in the shuffle. Don't worry — there are plenty of cards left to discover.\"}],[\"$\",\"div\",null,{\"className\":\"not-found-actions\",\"children\":[[\"$\",\"$Ld\",null,{\"href\":\"/\",\"className\":\"btn btn-yellow\",\"children\":\"Back to Home\"}],[\"$\",\"$Ld\",null,{\"href\":\"/events\",\"className\":\"btn btn-hero-ticket\",\"children\":\"Browse Events\"}]]}]]}]}]}],[\"$\",\"footer\",null,{\"className\":\"new-footer-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"new-footer-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"footer-cta-part\",\"children\":[[\"$\",\"p\",null,{\"className\":\"footer-eyebrow\",\"children\":\"Join Collector's Club\"}],[\"$\",\"h2\",null,{\"className\":\"footer-cta-title\",\"children\":[\"BE PART OF THE\",[\"$\",\"br\",null,{}],\"EXPERIENCE\"]}],[\"$\",\"p\",null,{\"className\":\"footer-cta-subtitle\",\"children\":[\"Connect with collectors, share the passion,\",[\"$\",\"br\",null,{}],\"and be part of something bigger.\"]}],[\"$\",\"$Ld\",null,{\"href\":\"#\",\"className\":\"btn btn-yellow footer-cta-btn\",\"children\":\"Subscribe\"}],[\"$\",\"div\",null,{\"className\":\"polaroid-cards-w