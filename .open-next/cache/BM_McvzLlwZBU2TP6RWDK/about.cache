ule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"logo\":\"https://collectorsparadise.com.au/images/logo.png\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Melbourne\",\"addressCountry\":\"AU\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"email\":\"hello@collectorsparadise.com.au\",\"contactType\":\"customer service\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://collectorsparadise.com.au/collections?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}</script><nav class=\"navbar  \"><div class=\"navbar-inner\"><a class=\"navbar-logo-link\" href=\"/\"><img alt=\"Collector&#x27;s Paradise\" width=\"180\" height=\"55\" decoding=\"async\" data-nimg=\"1\" class=\"navbar-logo\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=384&amp;q=75\"/></a><div class=\"navbar-actions\"><div class=\"navbar-login-wrapper\"><button class=\"navbar-join-pill\">LOGIN / SIGN-UP<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"margin-left:6px;transition:transform 0.2s;transform:rotate(0deg)\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></button><div class=\"navbar-login-dropdown \"><div class=\"navbar-login-dropdown-inner\"><a class=\"login-dropdown-item\" href=\"/login\"><span class=\"login-item-title\">Login to Account</span><span class=\"login-item-desc\">Access your collector portal</span></a><a class=\"login-dropdown-item\" href=\"/signup\"><span class=\"login-item-title\">Sign Up as Buyer</span><span class=\"login-item-desc\">Get tickets &amp; track your orders</span></a><a class=\"login-dropdown-item\" href=\"/vendors/apply\"><span class=\"login-item-title\">Apply as Vendor</span><span class=\"login-item-desc\">Secure a booth &amp; sell your collection</span></a></div></div></div><div class=\"navbar-menu-wrapper\" style=\"position:relative\"><button class=\"navbar-menu-icon  nav-icon-gray\" aria-label=\"Toggle menu\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button><div class=\"navbar-dropdown \"><div class=\"navbar-dropdown-inner\"><a href=\"/about\"><span class=\"menu-item-text\">About</span></a><a href=\"/events\"><span class=\"menu-item-text\">Events</span></a><a href=\"/collections\"><span class=\"menu-item-text\">Collections</span></a><a href=\"/vendors\"><span class=\"menu-item-text\">Vendors</span></a></div></div></div></div></div></nav><main class=\"about-page-wrapper\"><section class=\"about-hero-section\"><div class=\"about-hero-container\"><div class=\"about-hero-content\" style=\"opacity:0;transform:translateY(30px)\"><span class=\"about-eyebrow\">Our Story</span><h1 class=\"about-title\">About <span class=\"title-accent\">Us</span></h1><p class=\"about-description\">Collector&#x27;s Paradise is Melbourne&#x27;s premier destination for TCG enthusiasts. We bring the community together through immersive events, live pack breaks, expert evaluations, and a curated marketplace for the rarest finds.</p></div><div class=\"about-hero-stats\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"stat-item\"><span class=\"stat-number\">50+</span><span class=\"stat-label\">Events Hosted</span></div><div class=\"stat-divider\"></div><div class=\"stat-item\"><span class=\"stat-number\">10K+</span><span class=\"stat-label\">Collectors</span></div><div class=\"stat-divider\"></div><div class=\"stat-item\"><span class=\"stat-number\">100+</span><span class=\"stat-label\">Vendors</span></div></div></div></section><section class=\"experiences-section\"><div class=\"experiences-container\"><div class=\"experiences-header\" style=\"opacity:0;transform:translateY(30px)\"><span class=\"section-eyebrow\">What You&#x27;ll Experience</span><h2 class=\"section-heading\">Discover <span class=\"heading-accent\">Collector&#x27;s Paradise</span></h2><p class=\"section-subtitle\">Every event is a new adventure. Collect experiences, meet fellow trainers, and discover rare treasures.</p></div><div class=\"experiences-grid\"><div class=\"experience-card\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"experience-card-image\"><img alt=\"PSA Card Evaluations\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent\" sizes=\"(max-width: 768px) 100vw, 400px\" srcSet=\"/_next/image?url=%2Fimages%2F3rd-section-card-image.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2F3rd-section-card-image.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2F3rd-section-card-image.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2F3rd-section-card-image.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2F3rd-section-card-image.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2F3rd-section-card-image.jpg&amp;w=1920&amp;q=75 1920w\" src=\"/_next/image?url=%2Fimages%2F3rd-section-card-image.jpg&amp;w=1920&amp;q=75\"/></div><div class=\"experience-card-content\"><h3 class=\"experience-card-title\">PSA Card Evaluations</h3><p class=\"experience-card-desc\">Get your rare finds evaluated by experts and learn the true value of your collection. Real-time market data at your fingertips.</p></div><div class=\"experience-card-footer\"><span class=\"card-number\">01</span><span class=\"learn-more\">Learn More</span></div></div><div class=\"experience-card\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"experience-card-image\"><img alt=\"Guest Signings\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent\" sizes=\"(max-width: 768px) 100vw, 400px\" srcSet=\"/_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=1920&amp;q=75 1920w\" src=\"/_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=1920&amp;q=75\"/></div><div class=\"experience-card-content\"><h3 class=\"experience-card-title\">Guest Signings</h3><p class=\"experience-card-desc\">Meet your favorite artists and creators. Get your cards signed and captured in the moment. Experience pop culture history live.</p></div><div class=\"experience-card-footer\"><span class=\"card-number\">02</span><span class=\"learn-more\">Learn More</span></div></div><div class=\"experience-card\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"experience-card-image\"><img alt=\"Buy / Sell / Trade\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent\" sizes=\"(max-width: 768px) 100vw, 400px\" srcSet=\"/_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=1920&amp;q=75 1920w\" src=\"/_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=1920&amp;q=75\"/></div><div class=\"experience-card-content\"><h3 class=\"experience-card-title\">Buy / Sell / Trade</h3><p class=\"experience-card-desc\">The heart of the event. Connect with thousands of collectors. Find that one-of-a-kind card you&#x27;ve been searching for years.</p></div><div class=\"experience-card-footer\"><span class=\"card-number\">03</span><span class=\"learn-more\">Learn More</span></div></div></div></div></section><section class=\"badges-section\"><div class=\"badges-bg-grid\"></div><div class=\"badges-container\"><div class=\"badges-header\" style=\"opacity:0;transform:translateY(30px)\"><span class=\"section-eyebrow-dark\">Your Journey Awaits</span><h2 class=\"section-heading-dark\">Earn <span class=\"heading-yellow\">Gym Badges</span></h2><p class=\"section-desc-dark\">Every event is a chance to earn new badges. Collect them all and become a true Champion of Collector&#x27;s Paradise.</p></div><div class=\"badges-grid\"><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.1</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🎪</div></div><h3 class=\"badge-title\">First Event</h3><p class=\"badge-desc\">Attended your first Collector&#x27;s Paradise event</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.2</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🃏</div></div><h3 class=\"badge-title\">Card Collector</h3><p class=\"badge-desc\">Built a collection of 50+ cards</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.3</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🤝</div></div><h3 class=\"badge-title\">Trader</h3><p class=\"badge-desc\">Completed your first trade with another collector</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.4</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">⭐</div></div><h3 class=\"badge-title\">Rare Find</h3><p class=\"badge-desc\">Discovered a rare or holographic card</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.5</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🏪</div></div><h3 class=\"badge-title\">Vendor Ally</h3><p class=\"badge-desc\">Purchased from 5+ different vendors</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div><div class=\"badge-card\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"badge-card-inner\"><div class=\"badge-level\">Lv.6</div><div class=\"badge-icon-ring\"><div class=\"badge-icon\">🏆</div></div><h3 class=\"badge-title\">Champion</h3><p class=\"badge-desc\">Attended 10+ events and became a community pillar</p><div class=\"badge-progress\"><div class=\"badge-progress-bar\"></div></div></div></div></div><div class=\"badges-cta\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"cta-content\"><h3 class=\"cta-title\">Ready to Start Your Collection?</h3><p class=\"cta-subtitle\">Join our next event and begin earning your first badge today.</p><a class=\"cta-button\" href=\"/events\"><span>View Upcoming Events</span><span class=\"cta-arrow\">→</span></a></div></div></div></section></main><footer class=\"new-footer-section\"><div class=\"new-footer-container\"><div class=\"footer-cta-part\"><p class=\"footer-eyebrow\">JOIN THE COMMUNITY</p><h2 class=\"footer-cta-title\">BE PART OF THE<br/>EXPERIENCE</h2><p class=\"footer-cta-subtitle\">Connect with collectors, share the passion,<br/>and be part of something bigger.</p><a class=\"btn btn-yellow footer-cta-btn\" href=\"/events\">Buy Tickets</a><div class=\"polaroid-cards-wrapper\"><div class=\"polaroid p-1\"><img alt=\"Collectors meeting at a Pokémon trading card event\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Fmeet-fans.png&amp;w=640&amp;q=75\"/></div><div class=\"polaroid p-2\"><img alt=\"Live event experience at Collector&#x27;s Paradise\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Fevent-experience.png&amp;w=640&amp;q=75\"/></div><div class=\"polaroid p-3\"><img alt=\"Fun and culture at the collector community\" loading=\"lazy\" width=\"220\" height=\"220\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" srcSet=\"/_nex