dren\":[[\"$\",\"strong\",null,{\"children\":\"Account Information:\"}],\" Name, email address, phone number, and password when you register for an account.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Vendor Information:\"}],\" Business name, business description, logo, and booth preferences when you apply as a vendor.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Transaction Data:\"}],\" Event ticket purchases and registration details.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Usage Data:\"}],\" Pages visited, time spent on the site, browser type, and device information.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Communications:\"}],\" Messages you send us via contact forms or email.\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"legal-section\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"3. How We Use Your Information\"}],[\"$\",\"p\",null,{\"children\":\"We use the information we collect to:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Create and manage your account\"}],[\"$\",\"li\",null,{\"children\":\"Process event registrations and ticket purchases\"}],[\"$\",\"li\",null,{\"children\":\"Review and process vendor applications\"}],[\"$\",\"li\",null,{\"children\":\"Send event reminders and updates (with your consent)\"}],[\"$\",\"li\",null,{\"children\":\"Improve our website and services\"}],[\"$\",\"li\",null,{\"children\":\"Respond to your enquiries and support requests\"}],[\"$\",\"li\",null,{\"children\":\"Comply with legal obligations\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"legal-section\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"4. Sharing Your Information\"}],[\"$\",\"p\",null,{\"children\":\"We do not sell, trade, or rent your personal information to third parties. We may share your information with:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":