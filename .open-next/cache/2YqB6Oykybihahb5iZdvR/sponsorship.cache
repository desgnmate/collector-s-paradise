"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"logo\":\"https://collectorsparadise.com.au/images/logo.png\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Melbourne\",\"addressCountry\":\"AU\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"email\":\"hello@collectorsparadise.com.au\",\"contactType\":\"customer service\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Collector's Paradise\",\"url\":\"https://collectorsparadise.com.au\",\"description\":\"Melbourne's premier Pokémon trading card event. Buy, sell, trade rare cards and connect with the collector community.\"}</script><main><nav class=\"navbar  \"><div class=\"navbar-inner\"><a class=\"navbar-logo-link\" href=\"/\"><img alt=\"Collector&#x27;s Paradise\" width=\"168\" height=\"55\" decoding=\"async\" data-nimg=\"1\" class=\"navbar-logo\" style=\"color:transparent;width:auto\" src=\"/_next/static/media/logo.0qli1hbt-52sd.png\"/></a><div class=\"navbar-actions\"><a class=\"navbar-join-pill\" href=\"/vendors/apply\">APPLY AS VENDOR</a><div class=\"navbar-menu-wrapper\" style=\"position:relative\"><button class=\"navbar-menu-icon \" aria-label=\"Toggle menu\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button><div class=\"navbar-dropdown \"><div class=\"navbar-dropdown-inner\"><a href=\"/about\"><span class=\"menu-item-text\">About</span></a><a href=\"/events\"><span class=\"menu-item-text\">Events</span></a><a href=\"/vendors\"><span class=\"menu-item-text\">Vendors</span></a><a href=\"/sponsorship\"><span class=\"menu-item-text\">Sponsorship</span></a><a href=\"/volunteers\"><span class=\"menu-item-text\">Volunteers</span></a></div></div></div></div></div></nav><section class=\"vendors-page-header-section\"><div class=\"container\"><div class=\"vendors-page-header\"><span class=\"eyebrow-badge\">PARTNERSHIPS</span><h1 class=\"section-title\">SPONSORSHIP</h1><p class=\"section-subtitle\">Partner with Collector&#x27;s Paradise and connect with Melbourne&#x27;s most passionate Pokémon TCG community. Reach thousands of collectors at our events.</p></div></div></section><section class=\"vendors-cta-section\"><div class=\"container\"><div class=\"vendors-cta-inner\"><div class=\"vendors-cta-text\"><div class=\"vendors-cta-badge\"><span>WHY SPONSOR</span></div><h2 class=\"vendors-cta-title\">REACH 2,000+ COLLECTORS PER EVENT</h2><p class=\"vendors-cta-subtitle\">Our events attract serious collectors, players, and enthusiasts from across Melbourne and beyond. Sponsorship gives your brand direct access to this engaged community.</p></div><div class=\"vendors-cta-actions\"><a class=\"vendors-cta-btn-primary\" href=\"/sponsors/apply\">Become a Sponsor</a><a class=\"vendors-cta-btn-secondary\" href=\"/about\">Learn More About Us</a></div></div></div></section><footer class=\"new-footer-section\"><div class=\"new-footer-container\"><div class=\"footer-cta-part\"><p class=\"footer-eyebrow\">Join Collector&#x27;s Club</p><h2 class=\"footer-cta-title\">BE PART OF THE<br/>EXPERIENCE</h2><p class=\"footer-cta-subtitle\">Connect with collectors, share the passion,<br/>and be part of something bigger.</p><a class=\"btn btn-yellow footer-cta-btn\" href=\"#\">Subscribe</a><div class=\"polaroid-cards-wrapper\"><div class=\"polaroid p-1\"><img alt=\"Collectors meeting at a Pokémon trading card event\" loading=\"lazy\" width=\"150\" height=\"210\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static